{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@employment-agent/database": ["./packages/database/src/index.ts"],
      "@employment-agent/database/*": ["./packages/database/src/*"],
      "@employment-agent/domain": ["./packages/domain/src/index.ts"],
      "@employment-agent/domain/*": ["./packages/domain/src/*"],
      "@employment-agent/llm": ["./packages/llm/src/index.ts"],
      "@employment-agent/llm/*": ["./packages/llm/src/*"],
      "@employment-agent/resume-engine": ["./packages/resume-engine/src/index.ts"],
      "@employment-agent/resume-engine/*": ["./packages/resume-engine/src/*"],
      "@employment-agent/skill-runtime": ["./packages/skill-runtime/src/index.ts"],
      "@employment-agent/skill-runtime/*": ["./packages/skill-runtime/src/*"],
      "@employment-agent/browser": ["./packages/browser/src/index.ts"],
      "@employment-agent/browser/*": ["./packages/browser/src/*"],
      "@employment-agent/shared": ["./packages/shared/src/index.ts"],
      "@employment-agent/shared/*": ["./packages/shared/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".astro"]
}
