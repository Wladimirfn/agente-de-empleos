---
interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const { title, subtitle, class: extraClass = '' } = Astro.props;
const cls = `rounded border border-border bg-background/40 p-4 ${extraClass}`;
---
<section class={cls}>
  {title && (
    <header class="mb-3 flex items-start justify-between gap-4">
      <div>
        <h3 class="font-semibold text-foreground">{title}</h3>
        {subtitle && <p class="text-sm text-muted mt-1">{subtitle}</p>}
      </div>
      <div class="flex items-center gap-2">
        <slot name="actions" />
      </div>
    </header>
  )}
  <slot />
  <footer class="mt-4 pt-3 border-t border-border/50">
    <slot name="footer" />
  </footer>
</section>