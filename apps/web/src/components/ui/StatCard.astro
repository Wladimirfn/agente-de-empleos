---
interface Props {
  label: string;
  value: string | number;
  hint?: string;
  trend?: 'up' | 'down' | 'flat';
}

const { label, value, hint, trend } = Astro.props;
const trendCls = trend === 'up'
  ? 'text-green-400'
  : trend === 'down'
  ? 'text-red-400'
  : 'text-muted';
---
<div class="rounded border border-border bg-background/40 p-4">
  <p class="text-xs uppercase tracking-wide text-muted">{label}</p>
  <p class={`mt-2 text-2xl font-semibold ${trendCls}`}>{value}</p>
  {hint && <p class="mt-1 text-xs text-muted">{hint}</p>}
</div>