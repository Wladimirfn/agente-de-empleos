---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CvReviewForm from '../../components/islands/CvReviewForm';
---
<Base title="Currículums" activeRoute="/curriculums">
  <PageHeader
    title="Currículums"
    subtitle="Subí tu CV (PDF, DOCX o TXT). El sistema extrae el texto y vos confirmás qué datos quedan en el perfil."
  />

  <Card title="Subir nuevo CV" subtitle="El archivo se guarda en storage/curriculum/ y se registra una vez que confirmes el perfil.">
    <CvReviewForm client:load />
  </Card>

  <p class="mt-6 text-xs text-muted">
    Invariante: <strong>nada se guarda automáticamente</strong>. Cada campo del perfil requiere confirmación humana.
  </p>
</Base>