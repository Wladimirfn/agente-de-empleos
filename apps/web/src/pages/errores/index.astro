---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
---
<Base title="Errores" activeRoute="/errores">
  <PageHeader
    title="Errores y reparaciones"
    subtitle="Healthcheck de las skills. Las skills rotas aparecen acá para revisión humana."
  />

  <div class="space-y-3">
    <Card title="example-platform" subtitle="Último healthcheck: pendiente (el worker aún no corrió)">
      <div slot="actions">
        <Badge variant="neutral">Sin datos</Badge>
      </div>
    </Card>
  </div>
</Base>