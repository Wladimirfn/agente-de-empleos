---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import HealthDashboard from '../../components/islands/HealthDashboard';
---
<Base title="Errores" activeRoute="/errores">
  <PageHeader
    title="Errores y reparaciones"
    subtitle="Estado de cada skill instalada. Las fallas sin reparar requieren revisión humana."
  />

  <HealthDashboard client:load />

  <p class="mt-6 text-xs text-muted">
    Datos en vivo: el dashboard hace polling a <code class="text-accent">/api/health</code> cada 5 segundos.
  </p>
</Base>