---
import Base from '../../layouts/Base.astro';
---
<Base title="Errores" activeRoute="/errores">
  <h2 class="text-2xl font-semibold mb-4">Errores y reparaciones</h2>
  <p class="text-muted">Healthcheck de las skills. Las skills rotas aparecen acá para revisión humana.</p>
  <div class="mt-6 space-y-2">
    <div class="rounded border border-border p-4 flex items-center justify-between">
      <div>
        <h3 class="font-semibold">example-platform</h3>
        <p class="text-sm text-muted">Último healthcheck: pendiente (el worker aún no corrió)</p>
      </div>
      <span class="rounded bg-slate-500/20 text-slate-400 px-2 py-1 text-xs">Sin datos</span>
    </div>
  </div>
</Base>
