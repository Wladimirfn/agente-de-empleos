# =============================================================================
# Employment Agent — variables de entorno
# Copia este archivo a `.env` y completá los valores localmente.
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows)
# `.env` está en .gitignore: NUNCA se sube a Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Obligatorias (sin estas, la app no arranca bien)
# -----------------------------------------------------------------------------

# Ruta local de la base de datos SQLite. La carpeta `data/` está gitignored.
# Debe existir antes de correr migraciones (`npm run db:migrate`).
DATABASE_PATH=data/employment-agent.db

# Proveedor de LLM. `stub` no requiere credenciales y es ideal para desarrollo.
# Valores: stub | openai | anthropic | gemini | groq | nvidia | minimax | kimi | ollama | llamacpp
LLM_PROVIDER=stub

# -----------------------------------------------------------------------------
# Opcionales (tienen defaults seguros en el código)
# -----------------------------------------------------------------------------

# Puerto del servidor web (Astro).
WEB_PORT=3000

# Intervalo de heartbeat del worker, en segundos.
WORKER_HEARTBEAT_SECONDS=60

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Intervalo de polling SSE, en milisegundos.
SSE_POLL_MS=1000

# -----------------------------------------------------------------------------
# Credenciales de LLM (opcionales según el proveedor elegido en LLM_PROVIDER)
# Dejar en blanco el proveedor que no uses. Nunca subir valores reales.
# -----------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# NVIDIA NIM
NVIDIA_API_KEY=

# MiniMax
MINIMAX_API_KEY=

# Kimi / Moonshot
KIMI_API_KEY=

# Ollama (local). La URL puede variar entre desarrollo y producción.
OLLAMA_BASE_URL=http://localhost:11434/v1

# llama.cpp (local). La URL puede variar entre desarrollo y producción.
LLAMACPP_BASE_URL=http://localhost:8080/v1

# Modelo a usar. Si queda vacío, se usa el modelo por defecto del proveedor.
LLM_MODEL=
