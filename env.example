# Local SQLite database path
DATABASE_PATH=data/employment-agent.db

# LLM provider: stub | ollama | openai | anthropic (only stub supported in initial-foundation)
LLM_PROVIDER=stub

# Web server port
WEB_PORT=3000

# Worker heartbeat interval (seconds)
WORKER_HEARTBEAT_SECONDS=60

# Log level: debug | info | warn | error
LOG_LEVEL=info

# SSE poll interval (milliseconds)
SSE_POLL_MS=1000
