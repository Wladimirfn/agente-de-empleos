# Local SQLite database path
DATABASE_PATH=data/employment-agent.db

# LLM provider: stub | openai | anthropic | gemini | groq | nvidia | minimax | kimi | ollama | llamacpp
LLM_PROVIDER=stub

# Web server port
WEB_PORT=3000

# Worker heartbeat interval (seconds)
WORKER_HEARTBEAT_SECONDS=60

# Log level: debug | info | warn | error
LOG_LEVEL=info

# SSE poll interval (milliseconds)
SSE_POLL_MS=1000

# LLM provider credentials (fill locally; .env is gitignored)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
MINIMAX_API_KEY=
KIMI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLM_MODEL=
